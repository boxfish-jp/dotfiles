{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    },
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "git add *": "allow",
          "git mv *": "allow",
          "mkdir *": "allow",
          "mv *": "allow",
          "cp *": "allow",
          "touch *": "allow"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "which*": "allow",
      "type*": "allow",
      "true": "allow",
      "sleep *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "list *": "allow",
      "cd *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "date *": "allow",
      "opencode *": "allow",
      "strings *": "allow",
      "nix eval *": "allow",
      "readlink *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "free *": "allow",
      "uptime *": "allow",
      "whoami *": "allow",
      "id *": "allow",
      "sha256sum *": "allow",
      "md5sum *": "allow",
      "jq *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "xargs *": "allow",

      "sed *": "allow",
      "awk *": "allow",
      "gawk *": "allow",
      "mawk *": "allow",

      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git status*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git grep*": "allow",
      "git blame*": "allow",
      "git shortlog*": "allow",
      "git reflog*": "allow",
      "git ls-remote*": "allow",
      "git describe*": "allow",

      "git add*": "deny",
      "git mv*": "deny",
      "git rm*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "ask",
      "git fetch*": "ask",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git clone*": "ask",
      "git init*": "ask",
      "git stash*": "deny",

      "curl -sS *": "allow",
      "curl -fsSL *": "allow",
      "curl -I *": "allow",

      "nix flake check *": "allow",
      "env *": "deny",
      "printenv *": "deny",
      "mkdir *": "deny",
      "mv *": "deny",
      "cp *": "deny",
      "touch *": "deny",
      "sudo*": "deny"
    },
    "task": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/nix/store/**": "allow",
      "/home/boxfish/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "doom_loop": "ask"
  }
}
