{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "interleaved": { "field": "reasoning_content" }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "list *": "allow",
      "cd *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "rg *": "allow",
    },
    "task": "ask",
    "external_directory": {
      "*": "ask",
      "/nix/store/**": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "ask",
    "question": "allow",
    "doom_loop": "ask"
  }
}
