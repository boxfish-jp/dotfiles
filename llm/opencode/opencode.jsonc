{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    },
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "git add *": "allow",
          "git mv *": "allow",
          "mkdir *": "allow",
          "mv *": "allow",
          "cp *": "allow",
          "touch *": "allow"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "list *": "allow",
      "cd *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "date *": "allow",
      "opencode *": "allow",
      "strings *": "allow",
      "nix eval *": "allow",
      "readlink *": "allow",
      "sed *": "allow",
      "sed -i*": "deny",
      "sed --in-place*": "deny",

      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git status*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git grep*": "allow",
      "git blame*": "allow",
      "git shortlog*": "allow",
      "git reflog*": "allow",
      "git ls-remote*": "allow",

      "git add*": "deny",
      "git mv*": "deny",
      "git rm*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "ask",
      "git fetch*": "ask",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git clone*": "ask",
      "git init*": "ask",
      "git stash*": "deny",

      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git branch *": "deny",
      "git tag": "allow",
      "git tag -l*": "allow",
      "git tag -d*": "deny",
      "git tag *": "deny",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote show*": "allow",
      "git remote add*": "deny",
      "git remote remove*": "deny",
      "git remote set*": "deny",
      "git config --list": "allow",
      "git config --get*": "allow",
      "git config *": "deny",

      "nix flake check *": "allow",
      "mkdir *": "deny",
      "mv *": "deny",
      "cp *": "deny",
      "touch *": "deny",
      "sudo*": "deny"
    },
    "task": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/nix/store/**": "allow",
      "/home/boxfish/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "doom_loop": "ask"
  }
}
