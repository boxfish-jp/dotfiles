{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    },
      "build": {
        "permission": {
          "edit": "allow",
          "bash": {
            "mkdir *": "allow",
          "mv *": "allow",
          "cp *": "allow",
          "touch *": "allow"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "which*": "allow",
      "type*": "allow",
      "true": "allow",
      "sleep *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "list *": "allow",
      "timeout *": "allow",
      "cd *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "date *": "allow",
      "opencode *": "allow",
      "strings *": "allow",
      "nix eval *": "allow",
      "readlink *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "free *": "allow",
      "uptime *": "allow",
      "whoami *": "allow",
      "id *": "allow",
      "sha256sum *": "allow",
      "md5sum *": "allow",
      "jq *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "xargs *": "deny",

      "sed *": "allow",
      "awk *": "allow",
      "gawk *": "allow",
      "mawk *": "allow",

      "curl *": "allow",
      "git *": "allow",

      "nix flake check *": "allow",
      "nix log *": "allow",
      "nix build *": "allow",
      "nix fmt*": "allow",
      "env *": "deny",
      "printenv *": "deny",
      "mkdir *": "deny",
      "mv *": "deny",
      "cp *": "deny",
      "touch *": "deny",
      "sudo*": "deny",
      // シェル組み込み経由の任意実行
      "eval *": "deny",
      "source *": "deny",
      ". *": "deny",
      "npx *": "deny",
      "git commit *": "deny",
      "at *": "deny",
      "crontab *": "deny",
      "opencode run *": "deny",
      // 破壊・権限変更系
      "rm *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "chgrp *": "deny",
      "install *": "deny",
      "dd *": "deny",
      // 権限昇格・名前空間経由の実行
      "su *": "deny",
      "doas *": "deny",
      "runuser *": "deny",
      "pkexec *": "deny",
      "chroot *": "deny",
      "unshare *": "deny",
      "nsenter *": "deny",
      "bwrap *": "deny",
      "runc *": "deny",
      "crun *": "deny",
      "buildah *": "deny"
    },
    "task": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/nix/store/**": "allow",
      "/home/boxfish/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "doom_loop": "ask"
  }
}
