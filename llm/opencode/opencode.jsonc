{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    },
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "sed -i*": "allow",
          "sed --in-place*": "allow"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "list *": "allow",
      "cd *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "date *": "allow",
      "opencode *": "allow",
      "strings *": "allow",
      "nix eval *": "allow",
      "readlink *": "allow",
      "sed *": "allow",
      "sed -i*": "deny",
      "sed --in-place*": "deny",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "nix flake check *": "allow",
      "sudo*": "deny"
    },
    "task": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/nix/store/**": "allow",
      "/home/boxfish/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "doom_loop": "ask"
  }
}
