font-family = HackGen Console NF
font-size = 18
window-padding-x = 14
window-padding-y = 14
window-decoration = none
background-opacity = 0.6
background-blur = 20
command = zellij
term = xterm-256color
background = #16181a
foreground = #ffffff
palette = 0=#16181a
palette = 1=#ff6e5e
palette = 2=#5eff6c
palette = 3=#f1ff5e
palette = 4=#5ea1ff
palette = 5=#bd5eff
palette = 6=#5ef1ff
palette = 7=#ffffff
palette = 8=#3c4048
palette = 9=#ff6e5e
palette = 10=#5eff6c
palette = 11=#f1ff5e
palette = 12=#5ea1ff
palette = 13=#bd5eff
palette = 14=#5ef1ff
palette = 15=#ffffff
selection-background = #3c4048
selection-foreground = #ffffff
window-show-tab-bar = never
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

custom-shader = shaders/ghostty-cursor-trails/boo-cursor.glsl
custom-shader-animation = always

keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
